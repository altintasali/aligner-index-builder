import os

from snakemake.utils import min_version

min_version("8.0")


# Built-in defaults, part of the workflow itself -- not meant to be edited.
# Tool version pins live in workflow/default-config/versions.yaml; per-rule
# compute resources in workflow/default-config/resources.yaml. See the README.
# The paths are anchored on `repo_root` from the run config (written by the
# CLI): relative `configfile:` paths would otherwise resolve against the
# working directory, and the CLI runs snakemake with `--directory <outdir>`
# so `.snakemake` (metadata + lock) lands in the output dir instead of the
# repo clone. For hand-written direct configs, run from the repo root (or add
# `repo_root`).
_WORKFLOW_DIR = os.path.join(config.get("repo_root") or os.getcwd(), "workflow")

configfile: os.path.join(_WORKFLOW_DIR, "default-config", "versions.yaml")
configfile: os.path.join(_WORKFLOW_DIR, "default-config", "resources.yaml")

# Your run's config: normally generated by the CLI into the output directory:
#   workflow/scripts/aligner-index-builder --fasta ... --gtf ... -o OUTDIR
# which then runs `snakemake --configfile <OUTDIR>/config/<name>.config.yaml`.
# For direct runs: snakemake -s workflow/Snakefile --configfile path.yaml
# (see config/config.example.yaml for the documented keys).
include: "rules/common.smk"
include: "rules/index.smk"
include: "rules/qc.smk"


rule all:
    input:
        all_index_targets(),
        QC_MULTIQC_HTML,
        QC_MULTIQC_DATA,
